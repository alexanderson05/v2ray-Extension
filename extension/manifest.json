{
  "manifest_version": 3,
  "name": "V2 Client",
  "version": "2.0.0",
  "version_name": "2.0.0-beta.1",
  "description": "V2Ray / Xray client for Chrome. Designed by Alex Anderson.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "proxy", "nativeMessaging", "downloads", "alarms", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "V2 Client" }
}
