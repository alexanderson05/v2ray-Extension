{
  "manifest_version": 3,
  "name": "V2 Client",
  "version": "1.0.0",
  "description": "V2Ray/Xray client for Chrome",
  "permissions": ["storage", "proxy", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "V2 Client" }
}
